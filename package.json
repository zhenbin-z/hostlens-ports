{
  "name": "hostlens-ports",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight desktop viewer for listening ports and their processes.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
